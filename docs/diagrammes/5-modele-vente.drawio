        <mxCell id="m7" value="&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;&lt;i&gt;«racine d'agrégat»&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#1F2A44;&quot;&gt;&lt;b&gt;Seance&lt;/b&gt;&lt;/span&gt;&lt;hr size=&quot;1&quot; style=&quot;margin:3px 0;&quot;&gt;&lt;span style=&quot;font-size:12px;color:#1F2A44;&quot;&gt;id : SeanceId&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#1F2A44;&quot;&gt;debut : LocalDateTime&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#1F2A44;&quot;&gt;version : long        (verrou optimiste, ADR-0002)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#1F2A44;&quot;&gt;places : Map&amp;lt;PlaceId, EtatPlace&amp;gt;&lt;/span&gt;&lt;hr size=&quot;1&quot; style=&quot;margin:3px 0;&quot;&gt;&lt;span style=&quot;font-size:12px;color:#1F2A44;&quot;&gt;ouverte(id, debut, plan)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#1F2A44;&quot;&gt;bloquer(places, commande, maintenant) : fin du blocage&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#1F2A44;&quot;&gt;vendre(commande, places, maintenant)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#1F2A44;&quot;&gt;libererBlocagesExpires(maintenant) : Set&amp;lt;CommandeId&amp;gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#1F2A44;&quot;&gt;venteOuverteA(maintenant) · placesLibresA(maintenant)&lt;/span&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2F6FD0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="105" width="560" height="215" as="geometry"/></mxCell>
